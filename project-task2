print("⁣❌ Tic-Tac-Toe with small AI ⭕")

board=["" for _ in range(9)]

def show_board():
    print()
    print(board[0] +"|" + board[1] + "|" + board[2])
    print("--+--+--")
    print(board[3] + "|" + board[4] + "|" + board[5])
    print("--+--+--")
    print(board[6] + "|" + board[7] + "|" + board[8])

def check_winner(playerr):
    winning_positions=[(0,1,2), (3,4,5), (6,7,8), (0,3,6), (1,4,7), (2,5,8), (0,4,8), (2,4,6)]

    for a,b,c in winning_positions:
        if board[a]==board[b]==board[c]==playerr:
            return True 
        return False

def computer_move():
    for i in range(9):
        if board[i]=="":
            board[i]=="O"
            if check_winner("O"):
                board[i]="X"
                return
            board[i]=""

    if board[4]=="":
        board[4]="X"
        return
    for i in range(9):
        if board[i]=="":
            board[i]="X"
            return
print("TIC-TAC-TOE")
print("You = O")
print("Computer = X")

while True:
    show_board()
    try:
        position = int(input("Choose a position(1-9):"))-1
        if position<0 or position>8:
            print("Choose a number from 1 to 9.")
            continue
        if board[position]!="":
            print("That position is already occupied.")
            continue
        board[position]="O"
    except ValueError:
        print("Please enter a number.")
        continue
    if check_winner("O"):
        show_board()
        print("You win!")
        break
    if "" not in board:
        show_board()
        print("Draw!")
        break
    computer_move()
    if check_winner("X"):
        show_board()
        print("Computer wins!")
        break
    if "" not in board:
        show_board()
        print("Draw!")
        break